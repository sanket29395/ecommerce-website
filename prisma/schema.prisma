generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PAYMENT_REVIEW
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  role         Role            @default(CUSTOMER)
  createdAt    DateTime        @default(now())
  sessions     Session[]
  tokens       PasswordToken[]
  addresses    Address[]
  cart         CartItem[]
  wishlist     WishlistItem[]
  orders       Order[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model PasswordToken {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
}

model Address {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  phone   String
  line1   String
  line2   String @default("")
  city    String
  state   String
  pincode String
  country String @default("IN")

  @@index([userId])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String
  images      String[]
  active      Boolean        @default(false)
  featured    Boolean        @default(false)
  minPrice    Int?
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  wishlist    WishlistItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([active, categoryId])
  @@index([active, minPrice])
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  sku        String      @unique
  name       String
  price      Int
  stock      Int         @default(0)
  active     Boolean     @default(true)
  cart       CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([userId, variantId])
}

model WishlistItem {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  percent     Int
  minSubtotal Int      @default(0)
  maxUses     Int
  used        Int      @default(0)
  active      Boolean  @default(true)
  expiresAt   DateTime
  orders      Order[]
}

model Order {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  checkoutKey         String
  status              OrderStatus @default(PENDING)
  currency            String      @default("INR")
  subtotal            Int
  discount            Int         @default(0)
  shipping            Int
  total               Int
  address             Json
  couponId            String?
  coupon              Coupon?     @relation(fields: [couponId], references: [id])
  razorpayOrderId     String?     @unique
  razorpayPaymentId   String?     @unique
  refundedAmount      Int         @default(0)
  reservationReleased Boolean     @default(false)
  trackingUrl         String?
  carrier             String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               OrderItem[]

  @@unique([userId, checkoutKey])
  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  name      String
  sku       String
  image     String?
  price     Int
  quantity  Int

  @@index([orderId])
}

model WebhookEvent {
  id          String   @id
  event       String
  processedAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
