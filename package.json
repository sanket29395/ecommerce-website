{
  "name": "commerce",
  "version": "1.0.0",
  "description": "A full-stack Next.js ecommerce storefront and administration platform.",
  "private": true,
  "keywords": [
    "ecommerce",
    "nextjs",
    "typescript",
    "postgresql",
    "prisma",
    "razorpay"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "payments:reconcile": "node --env-file-if-exists=.env --import tsx scripts/reconcile.ts",
    "maintenance": "node --env-file-if-exists=.env --import tsx scripts/maintenance.ts",
    "format": "prettier --write src tests scripts docs README.md next.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests scripts docs README.md next.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "16.3.5",
    "nodemailer": "10.0.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
